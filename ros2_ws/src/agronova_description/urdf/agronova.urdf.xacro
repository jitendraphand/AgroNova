<?xml version="1.0"?>
<!-- PLACEHOLDER geometry/masses (SRS A-7). Replace with CAD-derived values. -->
<robot name="agronova" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:property name="wheel_radius" value="0.15"/>
  <xacro:property name="wheel_width" value="0.08"/>
  <xacro:property name="track_width" value="0.50"/>
  <xacro:property name="wheel_base" value="0.50"/>
  <xacro:property name="body_l" value="0.70"/>
  <xacro:property name="body_w" value="0.40"/>
  <xacro:property name="body_h" value="0.25"/>
  <xacro:property name="body_mass" value="37.0"/>
  <xacro:property name="wheel_mass" value="2.0"/>

  <link name="base_footprint"/>
  <link name="base_link">
    <visual><geometry><box size="${body_l} ${body_w} ${body_h}"/></geometry></visual>
    <collision><geometry><box size="${body_l} ${body_w} ${body_h}"/></geometry></collision>
    <inertial><mass value="${body_mass}"/>
      <inertia ixx="${body_mass*(body_w*body_w+body_h*body_h)/12}" ixy="0" ixz="0"
               iyy="${body_mass*(body_l*body_l+body_h*body_h)/12}" iyz="0"
               izz="${body_mass*(body_l*body_l+body_w*body_w)/12}"/></inertial>
  </link>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/><child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius + 0.05}"/>
  </joint>

  <xacro:macro name="wheel" params="name x y">
    <link name="${name}_wheel">
      <visual><origin rpy="${pi/2} 0 0"/><geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry></visual>
      <collision><origin rpy="${pi/2} 0 0"/><geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry></collision>
      <inertial><mass value="${wheel_mass}"/>
        <inertia ixx="${wheel_mass*(3*wheel_radius*wheel_radius+wheel_width*wheel_width)/12}" ixy="0" ixz="0"
                 iyy="${wheel_mass*wheel_radius*wheel_radius/2}" iyz="0"
                 izz="${wheel_mass*(3*wheel_radius*wheel_radius+wheel_width*wheel_width)/12}"/></inertial>
    </link>
    <joint name="${name}_wheel_joint" type="continuous">
      <parent link="base_link"/><child link="${name}_wheel"/>
      <origin xyz="${x} ${y} -0.05"/><axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>
  <xacro:wheel name="front_left"  x="${wheel_base/2}"  y="${track_width/2}"/>
  <xacro:wheel name="front_right" x="${wheel_base/2}"  y="${-track_width/2}"/>
  <xacro:wheel name="rear_left"   x="${-wheel_base/2}" y="${track_width/2}"/>
  <xacro:wheel name="rear_right"  x="${-wheel_base/2}" y="${-track_width/2}"/>
</robot>
