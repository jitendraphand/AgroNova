Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Fixed Frame: odom
    Background Color: 48; 48; 48
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 20
      Reference Frame: odom
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Topic:
        Value: /robot_description
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Marker Scale: 0.5
    - Class: rviz_default_plugins/LaserScan
      Name: LaserScan
      Enabled: true
      Topic:
        Value: /scan
        Reliability Policy: Best Effort
      Size (m): 0.06
      Style: Flat Squares
      Color Transformer: FlatColor
      Color: 255; 40; 40
      Decay Time: 0
    - Class: rviz_default_plugins/Odometry
      Name: Odometry (EKF)
      Enabled: true
      Topic:
        Value: /odometry/local
      Keep: 200
      Shape:
        Value: Arrow
        Shaft Length: 0.25
        Head Length: 0.08
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 9
      Focal Point: {X: 4, Y: 0, Z: 0}
      Pitch: 0.75
      Yaw: 3.6
      Target Frame: odom
Window Geometry:
  Width: 1280
  Height: 720
  Hide Left Dock: true
